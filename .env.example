# Copy this file to .env and fill in real values. Never commit .env.
# Phase 1 (underwriting engine + CLI) needs none of these — they're used
# starting Phase 2 (deal intake, reports) and Phase 4 (Sheets export).

# Required starting Phase 2: used to extract structured fields from pasted
# listing text and uploaded PDFs/rent rolls, and to write plain-English
# explanations of numbers the engine already computed. Get a key at
# https://console.anthropic.com/settings/keys (requires an Anthropic account
# and billing set up). Never used to calculate any number.
ANTHROPIC_API_KEY=
# Only needed if your API key is a workspace-unscoped "user" key (prefix
# sk-ant-usr-...). Find it at console.anthropic.com under workspace settings.
ANTHROPIC_WORKSPACE_ID=

# Optional starting Phase 2: path to the SQLite database file. Defaults to
# re_va.db in the project root if unset.
DATABASE_URL=sqlite:///re_va.db

# Optional starting Phase 4: path to a Google service account JSON key file,
# used only if you ask RE-VA to export a deal to Google Sheets.
GOOGLE_SHEETS_CREDENTIALS_PATH=
